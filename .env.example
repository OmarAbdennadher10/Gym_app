# --- Database (Supabase Postgres) ---
# Pooled connection (port 6543) — used by the running app for normal queries.
DATABASE_URL="postgresql://postgres.rpqsbwzfazfjrjukjzox:9dLzZyYTkfsZzJSx@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"
# Direct connection (port 5432) — used only by Prisma when running migrations.
DIRECT_URL="postgresql://postgres.rpqsbwzfazfjrjukjzox:9dLzZyYTkfsZzJSx@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# --- Auth ---
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

# --- LLM API (Kimi / Moonshot AI, OpenAI-compatible) ---
# Get this from platform.moonshot.ai (or moonshot.cn for the China endpoint).
# NEVER put this key in the Flutter app, NEVER commit the real .env file,
# NEVER paste it in chat — treat it like a password.
LLM_API_KEY="your-kimi-api-key-here"
LLM_BASE_URL="https://api.moonshot.ai/v1"
LLM_MODEL="kimi-k2-0711-preview"
# If you're in mainland China and moonshot.ai is unreachable, use:
# LLM_BASE_URL="https://api.moonshot.cn/v1"

# --- Server ---
PORT=3000
# Comma-separated list of origins allowed to call this API (your app doesn't
# need this for native HTTP calls, but it's needed if you ever add a web client)
CORS_ORIGIN="*"
